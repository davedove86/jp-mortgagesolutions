# JP Mortgage Solutions - static site on Eco Web Hosting (LiteSpeed / Apache)
# Pages are pre-rendered HTML files: /about-us is served from about-us.html.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) One-hop 301 to https://jp-mortgagesolutions.co.uk for http:// and www.
#    Never redirect Let's Encrypt / AutoSSL validation requests.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://jp-mortgagesolutions.co.uk%{REQUEST_URI} [R=301,L,NE]

# 2) Old .html / /index.html addresses -> clean URL (single 301).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ /%1 [R=301,L,NE]

# 3) Trailing slash on a page -> without slash (matches canonical URLs).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# 4) Clean URLs: /about-us -> about-us.html when that file exists.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([A-Za-z0-9_-]+)$ $1.html [L]

# Anything else that is not a real file falls through to ErrorDocument 404
# (/404.html, real 404 status) - no soft-404s for junk paths.
</IfModule>

# Content types
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# Caching: hashed build assets for a year, HTML always revalidated.
<IfModule mod_headers.c>
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/assets/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
